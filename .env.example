# ==============================================================================
# Royal Bagh Villa - Environment Variables Template (.env.example)
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit your real .env file to Git!
# - Keep all real secrets and production credentials strictly out of version control.
# ==============================================================================

# -- Flask Application Security ------------------------------------------------
# A strong, random key used to sign session cookies and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Set to "production" in production or "development" locally
FLASK_ENV=development


# -- Superadmin Initialization -------------------------------------------------
# Used by the seeder to initialize or repair the primary superadmin account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password


# -- Database Storage ----------------------------------------------------------
# Option 1 (Default): Leave empty to use local SQLite at instance/royal_bagh.db
# Option 2 (Render Persistent Disk): Set DATA_DIR=/var/data (database stored at /var/data/royal_bagh.db)
# Option 3 (Render PostgreSQL): postgresql://user:password@hostname:5432/dbname
DATABASE_URL=


# -- Production Storage & Persistence (Render) ---------------------------------
# Render Persistent Disk mount path.
# If attached at /var/data, SQLite DB and uploads are preserved across redeploys!
# DATA_DIR=/var/data
# PERSISTENT_DIR=/var/data


# -- Media Upload Limits -------------------------------------------------------
# Maximum file upload size in bytes (default: 67108864 = 64 MB for high-res photos & videos)
MAX_CONTENT_LENGTH=67108864


# -- Cloud Media Storage (Optional Cloudinary Integration) ---------------------
# If configured, image and video uploads are stored in Cloudinary CDN.
# If left blank, uploads are stored on the persistent disk or local filesystem.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# -- SSL & Cookie Security -----------------------------------------------------
# Automatically detected on Render (RENDER=true). Set to "true" when serving behind HTTPS.
SESSION_COOKIE_SECURE=false


# -- Payment Gateway (Optional / Ready) ----------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
